# Copy to .env and fill in. NEVER commit .env.
# Free LLM (Groq free tier). Any OpenAI-compatible provider works.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check Groq's current model list and set a current model here.
LLM_MODEL=openai/gpt-oss-120b

# Long random string; if empty, a random one is generated at startup (sessions reset on restart).
SECRET_KEY=
# Set to 1 when served over HTTPS (Render, Hugging Face, etc.)
COOKIE_SECURE=0

# Demo workspace: seeds fictional brand "Verdant" and three demo accounts.
SEED_DEMO=1
DEMO_PASSWORD=change-me-demo
# Show demo logins on the login page (needed so judges can try it without help)
DEMO_LOGIN_HINT=1
